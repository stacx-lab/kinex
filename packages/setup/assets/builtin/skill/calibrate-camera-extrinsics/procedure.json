{
  "version": 1,
  "roles": {
    "target": {
      "types": [
        "rgb",
        "rgbd"
      ]
    },
    "arm": {
      "types": [
        "joint"
      ]
    }
  },
  "requires": [
    {
      "role": "arm",
      "pointer": "/model"
    }
  ],
  "produces": [
    {
      "role": "target",
      "pointer": "/frames/base"
    }
  ],
  "computes": [
    "camera-extrinsics",
    "camera-stereo-extrinsics"
  ],
  "quality": "At least 5 diverse pairs; rotation residual <= 2 degrees and translation residual <= 10 mm; a joint stereo solve requires RMS angular residual <= 0.5 degrees."
}
