{
  "version": 1,
  "roles": {
    "target": {
      "types": [
        "rgb",
        "rgbd"
      ]
    },
    "arm": {
      "types": [
        "joint"
      ],
      "optional": true
    }
  },
  "requires": [
    {
      "role": "arm",
      "pointer": "/model"
    }
  ],
  "produces": [
    {
      "role": "target",
      "pointer": "/frames/base"
    },
    {
      "role": "target",
      "pointer": "/frames/left"
    },
    {
      "role": "target",
      "pointer": "/frames/right"
    }
  ],
  "computes": [
    "camera-extrinsics",
    "camera-stereo-extrinsics",
    "camera-eye-to-eye"
  ],
  "quality": "At least 5 diverse pairs; rotation residual <= 2 degrees and translation residual <= 10 mm; stereo solves require at least 5 views, RMS angular residual <= 0.5 degrees and, with a nominal baseline, agreement within 5% (at least 2 mm)."
}
