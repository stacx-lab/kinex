{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2024"],
    "module": "NodeNext", "moduleResolution": "NodeNext",
    "rootDir": "src", "outDir": "dist", "declaration": true,
    "rewriteRelativeImportExtensions": true, "verbatimModuleSyntax": true,
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src"]
}
