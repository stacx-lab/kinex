{
  "name": "@kinex/core",
  "version": "0.10.3",
  "description": "Host-independent robotics runtime for coding agents",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src",
    "assets/**/*.md",
    "assets/**/*.py",
    "assets/**/*.sh",
    "assets/**/*.yaml",
    "assets/**/*.json",
    "assets/**/*.txt",
    "assets/**/*.xml",
    "README.md"
  ],
  "dependencies": {
    "zod": "^4.4.3",
    "yaml": "2.9.0",
    "jiti": "2.7.0",
    "tinyglobby": "0.2.15",
    "fast-xml-parser": "5.11.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.0"
  }
}
