{
  "name": "kinex",
  "version": "0.8.0",
  "description": "Standalone robotics coding agent powered by Pi",
  "type": "module",
  "bin": {
    "kinex": "bin/kinex.mjs"
  },
  "files": [
    "dist",
    "bin",
    "assets",
    "README.md"
  ],
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build:core": "node packages/core/script/build.mjs",
    "build": "node script/build.mjs",
    "typecheck": "npm run build:core && npm run build:adapters && tsc --noEmit -p tsconfig.json",
    "dev": "node bin/kinex.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:core": "npm run build:core && node --test packages/core/test/*.test.mjs",
    "test:tui": "node --test test/tui.test.mjs",
    "build:adapters": "node script/build-adapters.mjs",
    "test:adapters": "node --test packages/pi/test/*.test.mjs packages/opencode/test/*.test.mjs",
    "pack": "node script/release.mjs",
    "test:codex": "node --test packages/codex/test/*.test.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.86.1",
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@earendil-works/pi-tui": "0.86.1",
    "@kinex/core": "0.8.0",
    "@kinex/pi": "0.8.0",
    "proper-lockfile": "4.1.2",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@openai/codex": "0.155.1",
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@types/node": "22.20.4",
    "@types/proper-lockfile": "4.1.4",
    "opencode-ai": "1.18.31",
    "typescript": "5.9.3"
  }
}
