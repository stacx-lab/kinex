{
  "name": "kinex",
  "version": "0.9.0",
  "description": "Standalone robotics coding agent powered by Pi",
  "type": "module",
  "bin": {
    "kinex": "bin/kinex.mjs"
  },
  "files": [
    "dist",
    "bin",
    "assets",
    "README.md"
  ],
  "workspaces": [
    "packages/core",
    "packages/setup"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build:core": "node packages/core/script/build.mjs",
    "build": "node script/build.mjs",
    "typecheck": "npm run build:setup && tsc --noEmit -p tsconfig.json",
    "dev": "node bin/kinex.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:core": "npm run build:core && node --test packages/core/test/*.test.mjs",
    "test:tui": "node --test test/tui.test.mjs",
    "pack": "node script/release.mjs",
    "build:setup": "npm run build:core && node packages/setup/script/build.mjs",
    "test:setup": "npm run build:setup && node --test packages/setup/test/*.test.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@kinex/core": "0.9.0",
    "proper-lockfile": "4.1.2",
    "typebox": "1.3.27",
    "@kinex/setup": "0.9.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "5.9.3"
  }
}
